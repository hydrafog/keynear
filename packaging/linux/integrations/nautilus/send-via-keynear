#!/usr/bin/env bash
set -euo pipefail

if ! command -v keynear >/dev/null 2>&1; then
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name="Keynear" --icon="org.keynear.Keynear" \
      "Keynear unavailable" "Install keynear on PATH to share files."
  fi
  echo "error: keynear is not available on PATH" >&2
  exit 127
fi

paths=()

if [ -n "${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}" ]; then
  while IFS= read -r line; do
    if [ -n "$line" ]; then
      paths+=("$line")
    fi
  done <<< "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
elif [ "$#" -gt 0 ]; then
  paths=("$@")
fi

if [ "${#paths[@]}" -eq 0 ]; then
  exit 0
fi

exec keynear send -- "${paths[@]}"
